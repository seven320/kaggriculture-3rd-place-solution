# g4a3 第2世代(4区画目を自分で買う)から普通の PPO。学習率を半分(LR 2.5e-5)
AMP_SAMPLE=1
ANTI=1
CLR=2e-5
COMPILE_UPD=1
CRIT_FRAC=0.5
CRITIC=1
CRIT_LAST=1
ENT=0
EPOCHS=1
EVAL=100000
FASTCOL=1
FASTINF=1
FASTPOOL=1
GAMMA=1.0
GATE=4
GATE_WR=0.60
ITERS=100000
KSHARD=1
LAM=0.95
LAND_OPP=0
LEAGUE_EXTRA=/content/local_logs/tf_pn_ft.pt,/content/local_logs/orbit_g5g_gen72.pt,/content/local_logs/orbit_g5g4_gen14.pt,/content/local_logs/orbit_vpfn4_gen7.pt,/content/local_logs/orbit_vpfn4_gen7.pt,/content/local_logs/orbit_vpfn4_gen7.pt
MAXLAG=4
MB=2048
NBEST=48
NLEAGUE=72
NSELF=48
NTAPEUG=24
OPPCHUNK=1024
OPPDIR=/content/repo/experiments/exp182_mix_tape_plus_repairs/code/tape_ug
PACE=1
PACE_P0=0
PACE_P1=0
SAMPCHUNK=1024
SHAPE=0
SPLITFILE=/content/local_logs/split_tf2.json
STOCKTGT=/content/lab/agents/o37_g8/stock_target.json
SYNCPROF=1
VWARM=2
YARD=/content/local_logs/orbit_o19_gen9.pt
NG=1
QUAD_REC=1
MEMLOG=1
AVG_N=1
AVG_EVERY=0
GATEN=96
GATE_POOL=2
LAND=0
BETA=0.02
LR=2.5e-5
GATE_BEST_MIN=0.5
NG=1
MICRO=4
KSHARD=4
# 09-25: pn2p gen43(旧マスク)を rel 下駄で新マスクへ移し、そのまま PPO を続ける(ユーザー指示: 新マスクへ全面移行、3区画戦略も)。
#   無学習では旧マスクの手と同じ(nmb28 の前例: 対 gen28 1536局 0.501)。下駄 B=-6 は BC・PPO・エージェントで同じ値(mkagent_nmb <ckpt> <name> 6 rel)。
LEGAL_OPT=0
MASK_MIG=1
MIG_V=2
MIG_BASE=0
MIG_PEN=6
MIG_HOLD=1000000
MIG_ZERO=1000001
# 09-26 pntom45: 今の一番手 pn2pnm gen45 から枝。手本 = pr_tom_pnm45(gen45 そのもの + トマト規則)が打った発火局の規則の席のうち、
#   ラベルにトマトの手(PLANT/BUY_SEED/SELL TOMATO)がある局面だけ(ext4p/tom45_sel、分割 bc_tom45)。作り方 lab/tomgen45/。
#   前回(pntnm/pnmtom 0.05、教師 gen36、15日目以降の全局面)はトマトの町以外で負けた。教師を自分と同じ版にし、局面をトマトの手に絞ったので、
#   トマト以外のラベルは自分の貪欲手(引っ張りは自分の尖らせだけ)。トマトの手への実効の重みは前回(トマトの局面 約5% × 0.05)の約8倍になるので係数は 0.02。
AUX_BC=0.02
AUX_BC_SPLIT=tom45
AUX_BC_CACHE=/workspace/kaggriculture/ext4p/tom45_sel
AUX_BC_MB=256
# 09-29 p4v: 3区画の本線(pntom45 gen28)から、4区画目の「使い方」を買わずに覚えさせる(状態だけの変種、原因調査 why-4q の手順①②)。
#   学習の局の4割を変種に: rs = 最初から4区画(資金 3000〜8000)、pr = 240〜300手で片方の座席に区画を1つ無料で足す(資金・市場は動かさない)。
#   規則は公式のまま、関門・評価は公式。E4・PFN 手本は使わない(崩れた原因)。使えるようになったら AUX_LAND 0.3 で購入へ切り替える
TAG=p4v
ASYNC_DIR=/content/async/p4v
INIT=/content/local_logs/orbit_pntom45_gen28.pt
CRITINIT=/content/local_logs/crit_pntom45_warm_p4v.pt
SCRIPT=apo_var_nmbrel.py
VAR=1
VAR_MIX=rs:0.5,pr:0.5
VAR_P=0.4
VAR_HOLD=400
VAR_ZERO=60
VAR_KINDS=self,best,league
VAR_CW=0.5
VAR_KLW=1
VAR_ADVN=group
VAR_ENT_LO=0.6
VAR_ENT_HI=2.2
VAR_KL_MAX=0.08
VAR_BAD_N=3
VAR_GATE_FAILS=8
VAR_PAUSE=6
VAR_RS_Q=4
VAR_RS_M=3000,8000
VAR_PR_T=240,300
VAR_PR_MF=1,1
VAR_PR_QP=1.0
VAR_PR_MSD=0
VAR_PR_MA=0,0

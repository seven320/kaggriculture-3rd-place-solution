# 09-25: pn2p gen43(旧マスク)を rel 下駄で新マスクへ移し、そのまま PPO を続ける(ユーザー指示: 新マスクへ全面移行、3区画戦略も)。
#   無学習では旧マスクの手と同じ(nmb28 の前例: 対 gen28 1536局 0.501)。下駄 B=-6 は BC・PPO・エージェントで同じ値(mkagent_nmb <ckpt> <name> 6 rel)。
TAG=pn2pnm
ASYNC_DIR=/content/async/pn2pnm
INIT=/content/local_logs/orbit_pn2p_gen43.pt
CRITINIT=/content/local_logs/crit_pn2p_warm_pn2pnm.pt
SCRIPT=apo_nmbrel.py
LEGAL_OPT=0
MASK_MIG=1
MIG_V=2
MIG_BASE=0
MIG_PEN=6
MIG_HOLD=1000000
MIG_ZERO=1000001

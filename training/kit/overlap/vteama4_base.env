# 09-28 vpfn4: 仮想 PFN4q。PFN 新提出 56612150(4区画 149/199/252 + トマト8日目から17粒、LB 1位)の手本 100座席を、我々の4区画 g4open gen18 から AUX_BC 0.03(LANDW 1)で寄せて PPO。リーグ相手・PFN 対策のものさし用。対照 g4open gen18
# g4a3 第2世代(4区画目を自分で買う)から普通の PPO。学習率を半分(LR 2.5e-5)
AMP_SAMPLE=1
ANTI=1
CLR=2e-5
COMPILE_UPD=1
CRIT_FRAC=0.5
CRITIC=1
CRIT_LAST=1
ENT=0
EPOCHS=1
EVAL=100000
FASTCOL=1
FASTINF=1
FASTPOOL=1
GAMMA=1.0
GATE=4
GATE_WR=0.60
ITERS=100000
KSHARD=1
LAM=0.95
LAND_OPP=0
LEAGUE_EXTRA=/content/local_logs/orbit_pn2p_gen45.pt,/content/local_logs/orbit_plgnm_gen2.pt,/content/local_logs/orbit_pn2pnm_gen3.pt,/content/local_logs/orbit_pn2p_gen43.pt,/content/local_logs/orbit_g5g_gen78.pt
MAXLAG=4
MB=2048
NBEST=48
NLEAGUE=72
NSELF=48
NTAPEUG=24
OPPCHUNK=1024
OPPDIR=/content/repo/experiments/exp182_mix_tape_plus_repairs/code/tape_ug
PACE=1
PACE_P0=0
PACE_P1=0
SAMPCHUNK=1024
SHAPE=0
SPLITFILE=/content/local_logs/split_tf2.json
STOCKTGT=/content/lab/agents/o37_g8/stock_target.json
SYNCPROF=1
VWARM=2
YARD=/content/local_logs/orbit_o19_gen9.pt
NG=1
QUAD_REC=1

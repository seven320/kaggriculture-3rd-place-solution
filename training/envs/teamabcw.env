# PPO from the shimishige MMPQ-BCw policies with the kit's code. Source after the kit's pntom45_base.env
# (run_ppo.sh does this); only the lines below differ from it.
#
# This is a reconstruction, not the env of the original run pntom45_mmpqbcw_sub112_a100x4_r1: that env
# is in none of the three datasets, and the policy dataset has no optimizer state. What is known from
# the dataset names and README: the line is "MMPQ-BCw Self PPO" on the pntom45 line. The choices below
# (critic, league, AUX_BC coefficient) are ours.
TAG=mmpqbcw_local
ASYNC_DIR=$ROOT/content/async/mmpqbcw_local
INIT=$LOGS/orbit_mmpqbcw_gen41.pt
# critic: the latest critic of the pntom45 line in the kit. A new critic costs about 0.04 of win rate (kit README 09-29, section 4).
CRITINIT=$LOGS/crit_pntom45_warm_pnx.pt
# league: the kit's PFN-type yardsticks plus earlier generations of this line
LEAGUE_EXTRA=$LOGS/tf_pn_ft.pt,$LOGS/orbit_vpfn4_gen7.pt,$LOGS/orbit_pntom45_gen32.pt,$LOGS/orbit_mmpqbcw_gen32.pt,$LOGS/orbit_mmpqbcw_gen34.pt,$LOGS/orbit_mmpqbcw_gen35.pt
# teacher for the auxiliary BC loss: M & M & P & Q seats made by tools/extract_teacher.py --split mmpq
AUX_BC=0.02
AUX_BC_SPLIT=mmpq
AUX_BC_CACHE=$ROOT/cluster/ext4p/mmpq
AUX_BC_MB=256
